---
// Why Choose Us / Trust section
import siteConfig from "@config/site";
import CtaButton from "@components/ui/CtaButton.astro";

const trustPoints = [
  {
    icon: "🤝",
    title: "Honest Work",
    description: "Transparent pricing, no surprises. We tell you exactly what needs to be done and what it costs.",
  },
  {
    icon: "🎯",
    title: "Fast Response",
    description: "Don't let a wildlife problem fester. We respond quickly to get the situation under control.",
  },
  {
    icon: "🌿",
    title: "Humane Methods",
    description: "We prioritize humane trapping and removal methods that respect wildlife while protecting your property.",
  },
  {
    icon: "📋",
    title: "NH Permitted",
    description: "Fully permitted New Hampshire Nuisance Wildlife Control Operator, listed on WildlifeHelp.org.",
  },
];
---

<section class="py-20 bg-kt-sand">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <span class="text-kt-green font-semibold text-sm uppercase tracking-wider">Why Choose Us</span>
      <h2 class="text-3xl md:text-4xl font-bold text-kt-dark mt-3 mb-4">
        Results You Can Count On
      </h2>
      <p class="text-kt-muted max-w-2xl mx-auto text-lg">
        We're your neighbors in Auburn, NH. We take pride in doing the job right the first time.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      {trustPoints.map((point) => (
        <div class="text-center">
          <div class="text-5xl mb-4">{point.icon}</div>
          <h3 class="text-lg font-bold text-kt-dark mb-2">{point.title}</h3>
          <p class="text-kt-muted leading-relaxed">{point.description}</p>
        </div>
      ))}
    </div>

    <!-- WildlifeHelp.org Trust Badge -->
    <div class="text-center bg-white rounded-2xl p-8 max-w-2xl mx-auto border border-kt-border">
      <p class="text-kt-muted text-sm mb-2">Listed on WildlifeHelp.org — a trusted source for</p>
      <p class="text-kt-green-dark font-semibold">
        Sound, Legal &amp; Responsible Wildlife Control
      </p>
      <p class="text-kt-muted text-xs mt-2">
        Supported by the Wildlife Management Institute &amp; Northeast Association of Fish &amp; Wildlife Agencies
      </p>
      <a
        href={siteConfig.wildlifeHelp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-kt-green text-sm font-medium hover:text-kt-accent transition-colors mt-3"
      >
        View our WildlifeHelp.org profile
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <div class="text-center mt-12">
      <CtaButton href="tel:+16036617272" variant="primary" size="lg">
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call {siteConfig.phone} Today
        </span>
      </CtaButton>
    </div>
  </div>
</section>
