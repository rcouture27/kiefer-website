  { src: "/assets/wildlife/687258695_122108207666847680_3981855542529057426_n.jpg", alt: "Property wildlife protection" },
  { src: "/assets/wildlife/687779528_122108935754847680_183036791453460599_n.jpg", alt: "Wildlife exclusion services" },
