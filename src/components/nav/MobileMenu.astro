---
// Mobile hamburger menu (Astro Islands with client-side interactivity)
import Logo from "@components/ui/Logo.astro";
import siteConfig from "@config/site";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
  { href: "/gallery", label: "Gallery" },
  { href: "/contact", label: "Contact" },
];
---

<div class="md:hidden">
  <!-- Hamburger Button -->
  <div class="bg-kt-dark/95 backdrop-blur-sm sticky top-0 z-50 border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <Logo variant="main" size="sm" />
        <span class="text-white font-bold text-sm leading-tight">{siteConfig.shortName}</span>
      </a>
      <button
        id="menu-toggle"
        class="text-white p-2 rounded-lg hover:bg-white/10 transition-colors"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Dropdown Menu -->
    <div id="mobile-menu" class="hidden border-t border-white/10">
      <div class="px-4 py-4 space-y-1 bg-kt-dark">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="block px-4 py-3 text-white/80 hover:text-kt-accent hover:bg-white/5 rounded-lg font-medium transition-colors"
          >
            {link.label}
          </a>
        ))}
        <div class="pt-3 mt-3 border-t border-white/10">
          <a
            href={siteConfig.phoneHref}
            class="flex items-center justify-center gap-2 bg-kt-accent hover:bg-kt-accent-hover text-white px-5 py-3 rounded-lg font-semibold transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call {siteConfig.phone}
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");

    toggle?.addEventListener("click", () => {
      menu?.classList.toggle("hidden");
      iconOpen?.classList.toggle("hidden");
      iconClose?.classList.toggle("hidden");
    });

    // Close menu when a link is clicked
    menu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        iconOpen.classList.remove("hidden");
        iconClose.classList.add("hidden");
      });
    });
  </script>
</div>
