---
// Desktop navigation bar
import Logo from "@components/ui/Logo.astro";
import siteConfig from "@config/site";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
  { href: "/gallery", label: "Gallery" },
  { href: "/contact", label: "Contact" },
];
---

<header class="hidden md:block bg-kt-dark/95 backdrop-blur-sm sticky top-0 z-50 border-b border-white/10">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <Logo variant="main" size="sm" />
        <div class="flex flex-col">
          <span class="text-white font-bold text-lg leading-tight group-hover:text-kt-accent transition-colors">
            {siteConfig.name}
          </span>
          <span class="text-white/60 text-xs">Wildlife Control & Gunsmith</span>
        </div>
      </a>

      <!-- Nav Links -->
      <div class="flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${
              link.href === "/"
                ? "text-white hover:text-kt-accent"
                : "text-white/80 hover:text-kt-accent hover:bg-white/5"
            }`}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Phone CTA -->
      <a
        href={siteConfig.phoneHref}
        class="flex items-center gap-2 bg-kt-accent hover:bg-kt-accent-hover text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-all btn-primary"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        {siteConfig.phone}
      </a>
    </div>
  </nav>
</header>
