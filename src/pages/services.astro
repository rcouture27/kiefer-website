---
// Services page
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import ServiceCard from "@components/services/ServiceCard.astro";
import SpeciesList from "@components/services/SpeciesList.astro";
import CtaButton from "@components/ui/CtaButton.astro";
import siteConfig from "@config/site";

const wildlifeServices = [
  {
    title: "Animal Removal",
    description: "Professional, humane removal of nuisance animals from your home and property. We handle raccoons, squirrels, skunks, bats, snakes, opossums, and more.",
    icon: "🦝",
    category: "wildlife" as const,
  },
  {
    title: "Humane Trapping",
    description: "Non-lethal and lethal trapping services as permitted in New Hampshire. We use the most effective, humane methods for each species and situation.",
    icon: "🪤",
    category: "wildlife" as const,
  },
  {
    title: "Property Protection & Prevention",
    description: "Exclusion services and prevention advice to keep wildlife out. We seal entry points, install deterrents, and advise on yard management to prevent future intrusions.",
    icon: "🛡️",
    category: "wildlife" as const,
  },
  {
    title: "Damage Repair",
    description: "Wildlife can cause significant structural damage. We repair entry points, damaged insulation, chewed wiring, and restore your property to safe condition.",
    icon: "🔨",
    category: "wildlife" as const,
  },
];

const gunsmithServices = [
  {
    title: "Firearm Repair & Maintenance",
    description: "Professional repair and routine maintenance for all major firearm types. From firing pin replacement to full strip-and-clean services.",
    icon: "🔧",
    category: "gunsmith" as const,
  },
  {
    title: "Custom Gunsmith Work",
    description: "Custom fitting, modifications, and craftsmanship tailored to your needs. Every piece is handled with precision and care.",
    icon: "⚙️",
    category: "gunsmith" as const,
  },
];

const species = [
  "Raccoon", "Tree Squirrel", "Skunk", "Snake", "Bat", "Coyote",
  "Beaver", "Opossum", "Fox", "Mole", "Rabbit", "Porcupine",
  "Woodchuck", "Chipmunk",
];
---

<BaseLayout>
  <slot name="head">
    <title>Services | Kiefer Tactical & Wildlife Services</title>
    <meta name="description" content="Wildlife removal, humane trapping, property protection, and gunsmith services in Southern New Hampshire." />
  </slot>

  <!-- Hero -->
  <section class="bg-kt-dark py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-kt-accent font-semibold text-sm uppercase tracking-wider">Our Services</span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-6">
        Professional Wildlife Control &amp; Gunsmith Work
      </h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">
        From nuisance wildlife in your attic to precision firearm work on your bench — we deliver quality results with integrity.
      </p>
    </div>
  </section>

  <!-- Wildlife Services -->
  <section id="wildlife" class="py-20 bg-kt-sand">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-12">
        <div class="w-12 h-1 bg-kt-green rounded-full"></div>
        <div>
          <h2 class="text-3xl font-bold text-kt-dark">Wildlife Services</h2>
          <p class="text-kt-muted mt-1">Humane, effective wildlife control throughout Southern NH</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 mb-12">
        {wildlifeServices.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            category={service.category}
          />
        ))}
      </div>

      <!-- Species handled -->
      <div class="bg-white rounded-2xl p-8 border border-kt-border">
        <h3 class="text-xl font-bold text-kt-dark mb-4">Species We Handle</h3>
        <SpeciesList species={species} />
      </div>
    </div>
  </section>

  <!-- Gunsmith Services -->
  <section id="gunsmith" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-12">
        <div class="w-12 h-1 bg-kt-accent rounded-full"></div>
        <div>
          <h2 class="text-3xl font-bold text-kt-dark">Gunsmith Services</h2>
          <p class="text-kt-muted mt-1">Expert craftsmanship and precision work</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 mb-12">
        {gunsmithServices.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            category={service.category}
          />
        ))}
      </div>

      <div class="bg-kt-dark rounded-2xl p-8 text-center text-white">
        <p class="text-white/70 text-lg mb-4">Need a custom job or have a specific firearm project in mind?</p>
        <CtaButton href="/contact" variant="primary" size="md">
          Get a Quote
        </CtaButton>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-kt-green-dark text-white text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold mb-4">Ready to Get Started?</h2>
      <p class="text-white/70 text-lg mb-8">
        Call or email us today for a free consultation. Fast response, fair pricing.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <CtaButton href={siteConfig.phoneHref} variant="primary" size="lg">
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call {siteConfig.phone}
          </span>
        </CtaButton>
        <CtaButton href={siteConfig.emailHref} variant="outline" size="lg">
          Email Us
        </CtaButton>
      </div>
    </div>
  </section>
</BaseLayout>
