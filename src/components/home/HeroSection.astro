---
// Hero section for the homepage
import siteConfig from "@config/site";
import CtaButton from "@components/ui/CtaButton.astro";
---

<section class="relative bg-kt-dark overflow-hidden">
  <!-- Background overlay with gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-kt-green-dark/80 via-kt-dark/90 to-kt-dark z-0"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 lg:py-40">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-kt-accent/20 text-kt-accent px-4 py-1.5 rounded-full text-sm font-medium mb-6">
          <span class="w-2 h-2 bg-kt-accent rounded-full animate-pulse"></span>
          Serving Southern New Hampshire
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6">
          Professional Wildlife
          <span class="text-kt-accent"> Control</span> &amp;
          <br />
          Gunsmith Services
        </h1>
        <p class="text-lg md:text-xl text-white/70 leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0">
          Humane animal removal, nuisance wildlife trapping, and expert gunsmith work.
          Fast response, fair pricing, honest work you can count on.
        </p>
        <div class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
          <CtaButton href="tel:+16036617272" variant="primary" size="lg">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              Call {siteConfig.phone}
            </span>
          </CtaButton>
          <CtaButton href="/contact" variant="outline" size="lg">
            Get a Free Quote
          </CtaButton>
        </div>
      </div>

      <!-- Stats / Trust Badges -->
      <div class="hidden lg:grid grid-cols-2 gap-6">
        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
          <div class="text-kt-accent text-4xl mb-3">🦝</div>
          <h3 class="text-white font-bold text-lg mb-1">Wildlife Removal</h3>
          <p class="text-white/60 text-sm">Raccoons, squirrels, skunks, bats, snakes &amp; more</p>
        </div>
        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
          <div class="text-kt-accent text-4xl mb-3">🔧</div>
          <h3 class="text-white font-bold text-lg mb-1">Gunsmith Work</h3>
          <p class="text-white/60 text-sm">Expert firearm repair, fitting &amp; custom work</p>
        </div>
        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
          <div class="text-kt-accent text-4xl mb-3">🛡️</div>
          <h3 class="text-white font-bold text-lg mb-1">Prevention</h3>
          <p class="text-white/60 text-sm">Property protection &amp; exclusion services</p>
        </div>
        <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10">
          <div class="text-kt-accent text-4xl mb-3">✅</div>
          <h3 class="text-white font-bold text-lg mb-1">NH Permitted</h3>
          <p class="text-white/60 text-sm">Licensed &amp; insured wildlife control operator</p>
        </div>
      </div>
    </div>
  </div>
</section>
