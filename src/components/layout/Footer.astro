---
// Site footer component
import Logo from "@components/ui/Logo.astro";
import siteConfig from "@config/site";

const footerLinks = [
  {
    title: "Navigation",
    links: [
      { href: "/", label: "Home" },
      { href: "/services", label: "Services" },
      { href: "/about", label: "About" },
      { href: "/gallery", label: "Gallery" },
      { href: "/contact", label: "Contact" },
    ],
  },
  {
    title: "Wildlife Services",
    links: [
      { href: "/services#wildlife", label: "Animal Removal" },
      { href: "/services#wildlife", label: "Humane Trapping" },
      { href: "/services#wildlife", label: "Prevention" },
      { href: "/services#wildlife", label: "Repairs" },
    ],
  },
  {
    title: "Gunsmith",
    links: [
      { href: "/services#gunsmith", label: "Gunsmith Services" },
      { href: "/contact", label: "Get a Quote" },
    ],
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-kt-dark text-white/80">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <!-- Brand Column -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <Logo variant="secondary" size="sm" />
          <div>
            <h3 class="text-white font-bold text-lg">{siteConfig.name}</h3>
            <p class="text-white/50 text-sm">Est. 2026</p>
          </div>
        </div>
        <p class="text-white/60 leading-relaxed mb-6 max-w-sm">
          Professional, humane wildlife control and expert gunsmith services in Southern New Hampshire.
          Honest work. Fair pricing. Results you can count on.
        </p>
        <div class="space-y-2 text-sm">
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-kt-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {siteConfig.address}
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-kt-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={siteConfig.phoneHref} class="hover:text-kt-accent transition-colors">{siteConfig.phone}</a>
          </p>
          <p class="flex items-center gap-2">
            <svg class="w-4 h-4 text-kt-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href={siteConfig.emailHref} class="hover:text-kt-accent transition-colors text-sm">{siteConfig.email}</a>
          </p>
        </div>
      </div>

      <!-- Link Columns -->
      {footerLinks.map((section) => (
        <div>
          <h4 class="text-white font-semibold mb-4">{section.title}</h4>
          <ul class="space-y-2">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm hover:text-kt-accent transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-white/40">
        &copy; {currentYear} {siteConfig.name}. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a
          href={siteConfig.wildlifeHelp}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-white/40 hover:text-kt-accent transition-colors"
        >
          Listed on WildlifeHelp.org
        </a>
        <span class="text-white/20">|</span>
        <a
          href={siteConfig.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-white/40 hover:text-kt-accent transition-colors"
        >
          Facebook
        </a>
      </div>
    </div>
  </div>
</footer>
