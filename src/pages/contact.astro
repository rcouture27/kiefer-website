---
// Contact page
export const prerender = true;
import BaseLayout from "@layouts/BaseLayout.astro";
import siteConfig from "@config/site";
import CtaButton from "@components/ui/CtaButton.astro";

const contactMethods = [
  {
    icon: "phone",
    title: "Call Us",
    description: "Fastest way to reach us. We're available during business hours and can often respond same-day.",
    value: siteConfig.phone,
    href: siteConfig.phoneHref,
    color: "kt-green",
  },
  {
    icon: "email",
    title: "Email Us",
    description: "Send us details about your wildlife problem or gunsmith project. We'll get back to you promptly.",
    value: siteConfig.email,
    href: siteConfig.emailHref,
    color: "kt-accent",
  },
  {
    icon: "location",
    title: "Visit Us",
    description: "Based in Auburn, NH. Serving all of Southern New Hampshire.",
    value: siteConfig.address,
    href: "https://maps.google.com/?q=458+Manchester+Rd+Auburn+NH+03032",
    color: "kt-green-light",
  },
  {
    icon: "facebook",
    title: "Facebook",
    description: "Follow us on Facebook for updates and to send us a direct message.",
    value: "Kiefer Tactical & Wildlife Services",
    href: siteConfig.facebook,
    color: "kt-green-dark",
  },
];

const iconMap = {
  phone: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />',
  email: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />',
  location: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />',
  facebook: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />',
};
---

<BaseLayout>
  <slot name="head">
    <title>Contact | Kiefer Tactical & Wildlife Services</title>
    <meta name="description" content="Get in touch with Kiefer Tactical & Wildlife Services. Call, email, or find us on Facebook." />
  </slot>

  <!-- Hero -->
  <section class="bg-kt-dark py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-kt-accent font-semibold text-sm uppercase tracking-wider">Contact Us</span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-6">
        Get In Touch
      </h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">
        Ready to solve your wildlife problem or start a gunsmith project? Reach out today.
      </p>
    </div>
  </section>

  <!-- Contact Methods -->
  <section class="py-20 bg-kt-sand">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        {contactMethods.map((method) => (
          <a
            href={method.href}
            target={method.href.startsWith("http") ? "_blank" : undefined}
            rel={method.href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="service-card bg-white rounded-xl p-6 text-center hover:shadow-lg border border-kt-border"
          >
            <div class={`w-14 h-14 mx-auto mb-4 rounded-full bg-${method.color}/10 flex items-center justify-center`}>
              <svg class="w-6 h-6 text-kt-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {iconMap[method.icon as keyof typeof iconMap]}
              </svg>
            </div>
            <h3 class="text-lg font-bold text-kt-dark mb-1">{method.title}</h3>
            <p class="text-kt-accent font-semibold mb-2">{method.value}</p>
            <p class="text-kt-muted text-sm leading-relaxed">{method.description}</p>
          </a>
        ))}
      </div>

      <!-- Map Placeholder -->
      <div class="bg-white rounded-2xl border border-kt-border overflow-hidden">
        <div class="h-64 bg-kt-sand flex items-center justify-center">
          <div class="text-center">
            <svg class="w-12 h-12 text-kt-green mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
            <p class="text-kt-muted font-medium">Auburn, NH 03032</p>
            <p class="text-kt-muted text-sm mt-1">Serving Southern New Hampshire</p>
            <a
              href="https://maps.google.com/?q=458+Manchester+Rd+Auburn+NH+03032"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-kt-green text-sm font-medium hover:text-kt-accent transition-colors mt-3"
            >
              Open in Google Maps
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form Placeholder -->
  <section class="py-20 bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-kt-dark mb-2">Send Us a Message</h2>
        <p class="text-kt-muted">
          While we respond fastest to phone calls and emails, leave a message below and we'll get back to you.
        </p>
      </div>

      <form class="space-y-6" action="mailto:Kiefertwservices@gmail.com" method="POST" enctype="text/plain">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-kt-dark mb-1" for="name">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 rounded-lg border border-kt-border bg-white text-kt-dark focus:outline-none focus:ring-2 focus:ring-kt-accent/50 focus:border-kt-accent transition-colors"
              placeholder="Your name"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-kt-dark mb-1" for="phone">Phone</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-3 rounded-lg border border-kt-border bg-white text-kt-dark focus:outline-none focus:ring-2 focus:ring-kt-accent/50 focus:border-kt-accent transition-colors"
              placeholder="Your phone number"
            />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-kt-dark mb-1" for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 rounded-lg border border-kt-border bg-white text-kt-dark focus:outline-none focus:ring-2 focus:ring-kt-accent/50 focus:border-kt-accent transition-colors"
            placeholder="your@email.com"
          />
        </div>
        <div>
          <label class="block text-sm font-medium text-kt-dark mb-1" for="service">Service Needed</label>
          <select
            id="service"
            name="service"
            class="w-full px-4 py-3 rounded-lg border border-kt-border bg-white text-kt-dark focus:outline-none focus:ring-2 focus:ring-kt-accent/50 focus:border-kt-accent transition-colors"
          >
            <option value="">Select a service...</option>
            <option value="wildlife-removal">Wildlife Removal</option>
            <option value="humane-trapping">Humane Trapping</option>
            <option value="prevention">Property Protection / Prevention</option>
            <option value="repair">Damage Repair</option>
            <option value="gunsmith">Gunsmith Services</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-kt-dark mb-1" for="message">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full px-4 py-3 rounded-lg border border-kt-border bg-white text-kt-dark focus:outline-none focus:ring-2 focus:ring-kt-accent/50 focus:border-kt-accent transition-colors resize-vertical"
            placeholder="Tell us about your situation..."
          ></textarea>
        </div>
        <div class="text-center">
          <button
            type="submit"
            class="btn-primary bg-kt-accent hover:bg-kt-accent-hover text-white px-8 py-3 rounded-lg font-semibold text-base shadow-md"
          >
            Send Message
          </button>
          <p class="text-kt-muted text-xs mt-2">
            Note: This form opens your email client. For fastest response, call us directly.
          </p>
        </div>
      </form>
    </div>
  </section>

  <!-- Quick CTA -->
  <section class="py-12 bg-kt-green-dark text-white text-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-3">Need Immediate Help?</h2>
      <p class="text-white/70 mb-6">
        Wildlife problems can't wait. Call us directly for the fastest response.
      </p>
      <CtaButton href={siteConfig.phoneHref} variant="primary" size="lg">
        <span class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {siteConfig.phone}
        </span>
      </CtaButton>
    </div>
  </section>
</BaseLayout>
