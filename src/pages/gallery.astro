// Filter tabs
const tabs = [
  { id: "all", label: "All Photos" },
  { id: "wildlife", label: "Wildlife" },
];
---

<BaseLayout>
  <slot name="head">
    <title>Gallery | Kiefer Tactical & Wildlife Services</title>
    <meta name="description" content="See our wildlife control work in Southern New Hampshire. Real results from real jobs." />
  </slot>

  <!-- Hero -->
  <section class="bg-kt-dark py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-kt-accent font-semibold text-sm uppercase tracking-wider">Gallery</span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-6">
        Our Work in Action
      </h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">
        Real photos from our wildlife control jobs across Southern New Hampshire.
      </p>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Filter Tabs -->
      <div class="flex items-center gap-2 mb-8 overflow-x-auto pb-2" id="gallery-filters">
        {tabs.map((tab, i) => (
          <button
            class={`px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors ${
              i === 0
                ? "bg-kt-green text-white"
                : "bg-kt-sand text-kt-muted hover:bg-kt-sand-dark"
            }`}
            data-filter={tab.id}
          >
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Photo Grid -->
      <div class="columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4" id="gallery-grid">
        {galleryImages.map((img) => (
          <div class="gallery-item break-inside-avoid rounded-xl overflow-hidden shadow-sm border border-kt-border">
            <div class="aspect-[4/3] bg-kt-sand flex items-center justify-center relative group">
              <img
                src={img.src}
                alt={img.alt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-kt-dark/0 group-hover:bg-kt-dark/40 transition-colors duration-300 flex items-center justify-center">
                <span class="text-white opacity-0 group-hover:opacity-100 transition-opacity font-medium text-sm">
                  {img.alt}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Note -->
      <div class="text-center mt-12 p-6 bg-kt-sand rounded-xl">
        <p class="text-kt-muted text-sm">
          📸 These photos showcase our wildlife control work. More images added as we complete more jobs.
          For gunsmith project photos, contact us directly.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter script -->
  <script>
    document.querySelectorAll("[data-filter]").forEach((button) => {
      button.addEventListener("click", () => {
        // Update active tab
        document.querySelectorAll("[data-filter]").forEach((btn) => {
          btn.className =
            "px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors bg-kt-sand text-kt-muted hover:bg-kt-sand-dark";
        });
        button.className =
          "px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors bg-kt-green text-white";
      });
    });
  </script>
</BaseLayout>
